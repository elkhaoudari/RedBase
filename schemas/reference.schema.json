{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redbase.invalid/schemas/reference.schema.json",
  "title": "RedBase Reference Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "url",
    "source_type",
    "license_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "standard",
        "research",
        "tool",
        "disclosure",
        "training",
        "blog",
        "other"
      ]
    },
    "license_status": {
      "enum": [
        "reviewed",
        "link_only",
        "permission_required",
        "unknown"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}