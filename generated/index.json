      "_path": "payloads/server-side/ssrf/web-server-side-ssrf-dns-rebinding-hostname-placeholder-001.yaml",
      "_record_type": "payload",
      "adapted_from": null,
      "content": "http://<rebinding-hostname>/",
      "encoding": "none",
      "expected_behavior": "Substitute a hostname whose authoritative nameserver is under tester control\nand configured with a low TTL and alternating answers between an allowed\naddress and a forbidden one.\n\nThe test succeeds if the validator resolves the allowed address and approves\nthe URL, and the fetch client then re-resolves the hostname within the TTL\nwindow and reaches the forbidden address. Success is evidenced by a callback\nor response from the forbidden destination.\n\nThis record documents the shape of the input; the mechanism itself is\ninfrastructure (authoritative nameserver, TTL, alternating records) rather\nthan a string. Many clients pin DNS for the duration of a request, defeating\nthe technique entirely. Treat a single failure as inconclusive.\n",
      "id": "web-server-side-ssrf-dns-rebinding-hostname-placeholder-001",
      "injection_context": "url-parameter",
      "license": "pending-policy-review",
      "name": "Hostname under authoritative-DNS control",
