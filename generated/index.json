    {
      "_path": "payloads/server-side/ssrf/web-server-side-ssrf-basic-cloud-metadata-001.yaml",
      "_record_type": "payload",
      "adapted_from": null,
      "content": "http://<metadata-endpoint>/<metadata-path>",
      "encoding": "none",
      "expected_behavior": "Substitute the metadata service endpoint and a provider-specific path for\nthe target platform. Behaviour differs by provider and by configuration.\n\nSome providers serve metadata on a link-local address over plain HTTP with\nno additional request requirements. Some require a session token obtained\nvia a separate request before the metadata can be read. Some require a\ncustom request header on every metadata request. Some restrict which paths\nare readable without additional configuration.\n\nA response containing metadata content indicates the fetch reached the\nservice and the request was accepted. A response indicating a token or\nheader requirement indicates the service is present but the payload alone\nis insufficient. A connection refusal or timeout does not establish that\nthe service is absent; it may be firewalled, hosted on a non-default\naddress, or unavailable from the fetch client's network position.\n",
      "id": "web-server-side-ssrf-basic-cloud-metadata-001",
      "injection_context": "url-parameter",
      "license": "pending-policy-review",
      "name": "Cloud instance metadata service probe",
      "references": [
        "https://www.rfc-editor.org/rfc/rfc3927",
        "https://cwe.mitre.org/data/definitions/918.html",
        "https://portswigger.net/web-security/ssrf"
      ],
      "related_payload": null,
      "review": {
