    {
      "_path": "payloads/server-side/ssrf/web-server-side-ssrf-redirect-validation-http-3xx-001.yaml",
      "_record_type": "payload",
      "adapted_from": null,
      "content": "https://attacker.example.com/redirect?url=http://<ip>/",
      "encoding": "none",
      "expected_behavior": "The first request is sent to a permitted host under tester control. That host\nresponds with a 3xx status and a Location header pointing at the substituted\ninternal destination.\n\nWhether this is exploitable depends on three properties of the fetch client:\n\n- whether it follows redirects at all;\n- whether it re-validates the destination of the redirect against the same\n  policy applied to the original URL;\n- whether it preserves properties the policy depends on (Host header,\n  scheme) across the redirect.\n\nA successful request to the internal destination — evidenced by a callback,\na response body, a timing difference, or a side effect — indicates the policy\nwas not re-applied after the redirect. Absence of evidence does not disprove\nthe vulnerability; the internal service may have been unreachable from the\nfetch client's network position.\n",
      "id": "web-server-side-ssrf-redirect-validation-http-3xx-001",
      "injection_context": "url-parameter",
